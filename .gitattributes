# Normalize EOL for all files that Git considers text files.
* text=auto eol=lf

# Editable 3D sources and exports belong in LFS, not Git's object history.
*.blend filter=lfs diff=lfs merge=lfs -text
*.glb filter=lfs diff=lfs merge=lfs -text
*.fbx filter=lfs diff=lfs merge=lfs -text
*.zip filter=lfs diff=lfs merge=lfs -text

# Preserve delivered art and work references without large binary Git blobs.
*.blend@ filter=lfs diff=lfs merge=lfs -text
*.kra filter=lfs diff=lfs merge=lfs -text
outputs/**/*.png filter=lfs diff=lfs merge=lfs -text
outputs/**/*.jpg filter=lfs diff=lfs merge=lfs -text
outputs/**/*.gif filter=lfs diff=lfs merge=lfs -text
work/**/*.png filter=lfs diff=lfs merge=lfs -text
work/**/*.jpg filter=lfs diff=lfs merge=lfs -text
work/**/*.gif filter=lfs diff=lfs merge=lfs -text
Assets/BlueBiome/Art/Lakeside3D/**/*.png filter=lfs diff=lfs merge=lfs -text
Assets/BlueBiome/Art/LakesideMap/**/*.png filter=lfs diff=lfs merge=lfs -text
Assets/BlueBiome/Characters/**/*.png filter=lfs diff=lfs merge=lfs -text
Assets/BlueBiome/Enemies/EaveRunner/**/*.png filter=lfs diff=lfs merge=lfs -text
Assets/BlueBiome/Enemies/LoomHeron/**/*.png filter=lfs diff=lfs merge=lfs -text
Assets/BlueBiome/Villagers/**/*.png filter=lfs diff=lfs merge=lfs -text

# Keep vendored MakeHuman inputs intact, including upstream whitespace.
ArtSource/BlueBiome/Villagers/CC0_Source/** -text -whitespace
work/lakeside-villagers/source/** -text -whitespace
# Upstream's seven-character Markdown heading is not a merge conflict.
work/lakeside-villagers/source/LICENSE.md conflict-marker-size=32

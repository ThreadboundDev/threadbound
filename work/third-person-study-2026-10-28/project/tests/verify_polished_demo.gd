extends SceneTree
var world
var actor
var enemies: Array
var checks: Array[Dictionary] = []
func _initialize() -> void: call_deferred("run")
func frames(n: int) -> void:
	for i in range(n): await physics_frame
func check(label: String, ok: bool, detail = null) -> void:
	checks.append({"check":label,"passed":ok,"detail":detail})
	print("PASS " if ok else "FAIL ",label," ",detail)
func fixture(point := Vector3(0,0.1,17)) -> void:
	for action in InputMap.get_actions(): Input.action_release(action)
	world.reset_playtest()
	actor.global_position = point
	for i in range(enemies.size()):
		enemies[i].ai_enabled = false
		enemies[i].global_position = Vector3(30+i*1.5,5,-25)
	await frames(25)
	actor.momentum.reset()
	actor.previous_position = actor.global_position
	actor.combat.invulnerable = 0
func aim(point: Vector3) -> void:
	var direction: Vector3 = point-(actor.global_position+Vector3.UP*1.4)
	actor.yaw = atan2(-direction.x,-direction.z)
	actor.pitch = atan2(direction.y,Vector2(direction.x,direction.z).length())
	await frames(3)
func run() -> void:
	world = load("res://scenes/workshop_study.tscn").instantiate()
	root.add_child(world)
	actor = world.actor
	enemies = get_nodes_in_group("study_enemies")
	for enemy in enemies: enemy.ai_enabled = false
	await frames(40)
	check("Four field enemies and downloaded boss",enemies.size()==5 and world.boss.downloaded)
	check("Three added cottages",get_nodes_in_group("study_houses").size()==3)
	for house in get_nodes_in_group("study_houses"):
		var a: Vector3 = house.to_global(Vector3(-3,1.25,-2))
		var b: Vector3 = house.to_global(Vector3(3,1.25,-2))
		var wall_hit: Dictionary = world.get_world_3d().direct_space_state.intersect_ray(PhysicsRayQueryParameters3D.create(a,b,1))
		check("Cottage side walls retain assembled transforms",not wall_hit.is_empty() and house.is_ancestor_of(wall_hit.collider),house.global_position)
	check("Baked navigation contains walkable polygons",world.navigation.navigation_mesh.get_polygon_count()>0)
	for enemy in enemies:
		check(enemy.display_name+" has full rig and motion set",enemy.skeleton.get_bone_count()>=60 and enemy.animation.get_animation_list().size()>=10)
	check("Authored up/down/forward air attacks installed",actor.animation.has_animation("authored/air_attack_down") and actor.animation.has_animation("authored/air_attack_up") and actor.animation.has_animation("authored/air_attack_forward"))
	check("Water combo and both underwater specials installed",actor.animation.has_animation("water_combo/water_combo_3") and actor.animation.has_animation("water_combo/water_neutral_special") and actor.animation.has_animation("water_combo/water_spin_special"))
	check("Player and enemy blade trails installed",world.fx.trails.size()>=6)
	var head_id: int = world.boss.skeleton.find_bone("head")
	var head_pose: Transform3D = world.boss.skeleton.get_bone_global_pose(head_id)
	var head_world: Vector3 = world.boss.skeleton.to_global(head_pose.origin)
	check("Evaluated boss head matches physical scale",head_world.y-world.boss.global_position.y>2 and head_world.y-world.boss.global_position.y<3.8,head_world)
	check("Boss animation preserves unit bone scales",head_pose.basis.get_scale().is_equal_approx(Vector3.ONE),head_pose.basis.get_scale())
	await fixture()
	var wall = world.box("UnmarkedCollisionTest",Vector3(0,1.5,10),Vector3(5,3,0.5),world.palette.stone,true)
	await frames(2)
	await aim(Vector3(0,1.6,10.25))
	actor.grapple.update_candidate()
	check("Ordinary unmarked wall is targetable",actor.grapple.candidate==wall,actor.grapple.candidate)
	check("Collision hookshot fires and costs 1 AP",actor.grapple.fire() and actor.combat.available_ap()==5)
	await frames(110)
	check("Wall pull arrives outside solid geometry",actor.global_position.z>10.53 and actor.global_position.z<11.5,actor.global_position)
	check("Hookshot arrives once and detaches safely",actor.grapple.connections>0 and not actor.grapple.active)
	await fixture()
	await aim(Vector3(3,0,12))
	check("Ordinary ground accepts hookshot",actor.grapple.fire())
	await frames(100)
	check("Floor hookshot lands above terrain",actor.global_position.distance_to(Vector3(3,0,12))<1 and actor.global_position.y>=-0.05,actor.global_position)
	await fixture()
	var ceiling = world.box("CeilingCollisionTest",Vector3(0,4,13),Vector3(5,0.3,5),world.palette.stone,true)
	await frames(2)
	await aim(Vector3(0,3.85,13))
	actor.grapple.update_candidate()
	check("Ceiling underside accepts hookshot",actor.grapple.candidate==ceiling)
	check("Ceiling hookshot fires",actor.grapple.fire())
	await frames(70)
	check("Ceiling pull never puts head through ceiling",actor.global_position.y+1.9<4.0,actor.global_position)
	ceiling.queue_free()
	wall.queue_free()
	await frames(2)
	await fixture(Vector3(12.5,0.3,2.5))
	await aim(Vector3(12.5,30,-20))
	check("Sky does not create a phantom grapple target",not actor.grapple.fire(),actor.grapple.candidate)
	await fixture()
	var enemy = enemies[0]
	enemy.global_position = actor.global_position+Vector3(0,0,-6)
	await frames(3)
	await aim(enemy.global_position+Vector3.UP)
	check("Enemy collision accepts hookshot",actor.grapple.fire())
	await frames(95)
	check("Enemy grapple strike damages once",enemy.health==enemy.max_health-30,enemy.health)
	await fixture()
	check("Dash costs one AP",actor.request_dash(Vector3.RIGHT) and actor.combat.available_ap()==5)
	check("Dash blocks immediate damage",not actor.combat.receive_hit(20,actor.global_position+Vector3.LEFT))
	check("Dash cooldown prevents repeat spending",not actor.request_dash(Vector3.RIGHT) and actor.combat.available_ap()==5)
	await fixture()
	actor.momentum.amount = 30
	check("Special costs two AP",actor.combat.special(false) and actor.combat.available_ap()==4)
	check("Base AP timers are independent",actor.combat.ap_timers.filter(func(t):return t>9.9).size()==2)
	await frames(80)
	actor.combat.action = ""
	await frames(535)
	check("AP restores after base ten-second timers",actor.combat.available_ap()==6)
	await fixture()
	enemy.global_position = actor.global_position+Vector3(0,0,-1.4)
	actor.visual.rotation.y = PI
	check("Basic attack starts",actor.combat.attack())
	await frames(20)
	var visible_trails: Array = world.fx.trails.filter(func(t):return t.owner_actor==actor and t.blade.visible and t.samples.size()>1)
	check("Sword swing emits a blade surface trail",not visible_trails.is_empty())
	check("Trail spans the blade instead of its thickness",visible_trails.all(func(t):return Vector3(t.samples.back().a).distance_to(t.samples.back().b)>0.55))
	check("Skinned sword trail stays beside the actual character",visible_trails.all(func(t):return t.samples.all(func(s):return Vector3(s.a).distance_to(actor.global_position)<3 and Vector3(s.b).distance_to(actor.global_position)<3)),visible_trails.map(func(t):return t.samples.back()))
	await frames(18)
	check("Basic sword strike damages one target once",enemy.health==enemy.max_health-25,enemy.health)
	await fixture()
	Input.action_press("block")
	await frames(2)
	check("Fresh shield parries frontal attack",not actor.combat.receive_hit(20,actor.global_position+Vector3.FORWARD) and actor.combat.health==100)
	await frames(20)
	actor.combat.receive_hit(20,actor.global_position+Vector3.FORWARD)
	check("Held guard retains chip damage",actor.combat.health==96,actor.combat.health)
	await fixture(Vector3(0,3,17))
	Input.action_press("descend")
	actor.combat.attack()
	check("Down air attack uses authored downward pose",actor.combat.air_direction=="down" and actor.current_clip=="air_attack_down")
	actor.air_jump_available = false
	actor.combat.pogo_bounce()
	check("Pogo refreshes air strike and lifts player",not actor.combat.air_used and actor.velocity.y>6)
	check("Pogo does not restore AP or air jump",actor.combat.available_ap()==6 and not actor.air_jump_available)
	await fixture()
	actor.global_position.y = 3.2
	actor.velocity = Vector3(0,-3,0)
	await frames(2)
	actor.air_jump_available = false
	enemy.global_position = Vector3(0,0,16.8)
	Input.action_press("descend")
	actor.combat.attack()
	await frames(8)
	check("Downward contact produces a real pogo rebound",enemy.health==enemy.max_health-25 and actor.velocity.y>3,actor.velocity)
	check("Contact pogo leaves air jump spent",not actor.air_jump_available and actor.combat.available_ap()==6)
	await fixture()
	Input.action_press("jump")
	await frames(4)
	Input.action_release("jump")
	await frames(2)
	Input.action_press("jump")
	await frames(2)
	check("Second jump spends one AP and refreshes upward movement",actor.combat.available_ap()==5 and not actor.air_jump_available and actor.velocity.y>5)
	await fixture()
	var climb_wall = world.box("MantleTestWall",Vector3(0,0.6,16.35),Vector3(4,1.2,0.3),world.palette.stone,true)
	await frames(2)
	actor.visual.rotation.y = PI
	check("Ledge mantle finds an unmarked solid top",actor.try_mantle())
	await frames(25)
	check("Mantle finishes on top with capsule clearance",not actor.mantling and actor.global_position.y>1.1,actor.global_position)
	climb_wall.queue_free()
	await frames(2)
	await fixture(Vector3(12.5,-1.4,-5))
	check("River enters swimming state",actor.swimming)
	check("Grapple is blocked underwater",not actor.grapple.fire())
	check("Underwater neutral special works",actor.combat.special(false) and actor.current_clip=="water_neutral_special")
	await fixture(Vector3(12.5,-1.4,-5))
	check("Underwater spin special works",actor.combat.special(true) and actor.current_clip=="water_spin_special")
	await fixture(Vector3(12.5,-1.4,-5))
	Input.action_press("descend")
	actor.request_dash(Vector3.FORWARD)
	await frames(3)
	check("Underwater dash uses vertical direction and AP",actor.velocity.y< -5 and actor.velocity.z< -5 and actor.combat.available_ap()==5,actor.velocity)
	await fixture()
	actor.momentum.amount = 50
	actor.combat.health = 30
	Input.action_press("meditate")
	await frames(72)
	check("Meditation trades ten Momentum for critical healing",actor.combat.health>=35 and actor.momentum.amount<=40,actor.combat.health)
	await fixture()
	var state = actor.momentum
	state.report("dash")
	var once: float = state.amount
	state.report("dash")
	check("Repeated actions become stale",state.amount<once)
	state.reset()
	state.amount = 100
	state.change(0)
	check("Full Momentum enters Flow",state.flow)
	state.tick(2,0,false)
	check("Flow persists while its meter drains",state.flow and state.amount<100 and state.amount>0)
	state.change(-200)
	check("Flow exits when depleted",not state.flow)
	world.reset_playtest()
	check("Reset restores all five enemies",enemies.all(func(e):return not e.dead and e.health==e.max_health))
	check("Reset restores AP, health and Momentum",actor.combat.available_ap()==6 and actor.combat.health==100 and actor.momentum.amount==0)
	var failed := checks.filter(func(c):return not c.passed).size()
	var file := FileAccess.open("res://polish_test_results.json",FileAccess.WRITE)
	file.store_string(JSON.stringify({"checks":checks,"failed":failed},"\t"))
	file.close()
	print("POLISH_CHECKS ",checks.size()," FAILED ",failed)
	world.queue_free()
	await process_frame
	await process_frame
	OS.delay_msec(150)
	quit(1 if failed else 0)

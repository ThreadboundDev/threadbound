# Godot 4+ specific ignores
.godot/
/android/

# Editor and art-tool backups
*~
*.tmp
*.autosave
*.autosave.*
*.kra-autosave.kra
*-autosave.kra

# Godot editor temporary scene saves
*.tscn*.tmp

# Local export/build outputs
/export_test/
/export_test.zip
/Threadbound_Windows_Send.zip
/Threadbound.exe
/Threadbound.console.exe
/Threadbound.pck
/data_Threadbound_windows_x86_64/
/ThreadboundMovement.avi
/ThreadboundMenu.avi
/Builds/
/export_templates/
/feature_profiles/
/script_templates/
/text_editor_themes/
Assets/UI/Main Menu/*.mp4

# Local @icons catalog used for browsing and selecting editor-only node icons.
# Referenced icons are copied into addons/at-icons and committed separately.
/tools/local/

# Local IDE/editor folders
.idea/

# Local Godot AI editor bridge. This is development-machine tooling, not a
# game/runtime dependency.
/addons/godot_ai/
/godot-ai-LICENSE.txt

# Local linked worktrees and generated task scratch space
/tmp/

# Local Godot user data created when user:// is redirected into the repository.
/Godot/

# Tool and render command output.
*.log

# Generated Python tool caches; keep the scripts, not interpreter bytecode.
__pycache__/
*.py[cod]

# Blender automatic backup copies; keep deliberate named source versions.
*.blend[0-9]*

# Reproducible isolated Godot imports and temporary Blender build directories.
# Keep work scripts, reports, reference inputs and deliberate review images.
/work/**/import_project/
/work/**/temp/
/work/**/build-temp/
/work/**/blender-temp/

# Raw animation captures; packaged GIFs and review stills remain versioned.
/work/character-quality-v2/heron-motion/
/work/loom-heron-v3/motion/
/work/woven-guardians/renders/Eave_[0-9]*.png*
/work/woven-guardians/renders/Heron_[0-9]*.png*
/work/lakeside-ui-rock/fracture_[0-9]*.png*
/work/lakeside-villagers/renders/greeting_[0-9]*.png*
/work/eave-runner/renders/motion_*.png*

# Separate 3D demo verification output (curated report lives above project/).
/work/third-person-study-2026-10-28/project/demo_feel*results.json

/work/third-person-study-2026-10-28/project/committed_combat_test_results.json

/work/third-person-study-2026-10-28/project/loom_trial_test_results.json

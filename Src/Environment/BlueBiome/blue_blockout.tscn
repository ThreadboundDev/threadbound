[sub_resource type="Shader" id="Shader_BridgeBackground"]
code = "shader_type canvas_item;

void fragment() {
    vec4 texel = texture(TEXTURE, UV);
    float luma = dot(texel.rgb, vec3(0.2126, 0.7152, 0.0722));
    vec3 wood = mix(vec3(luma), texel.rgb, 0.48) * vec3(0.82, 0.89, 1.0);
    COLOR = vec4(mix(wood, vec3(0.23, 0.35, 0.43), 0.24), texel.a * 0.94);
}
"

